// ═══════════════════════════════════════════════════════════════════
// LILLIE — Prisma Database Schema
// ═══════════════════════════════════════════════════════════════════
//
// Current database:   Neon PostgreSQL (production & local via pg)
// The provider is set to postgresql and DATABASE_URL points to
// the appropriate Neon connection string in each environment.
//
// ── Design Decisions ─────────────────────────────────────────────
//
// 1. Single User model (no separate preferences table)
//    For the current feature set (locale, template), putting preferences
//    directly on the User model avoids a JOIN and keeps the schema flat.
//    A separate UserPreferences model can be introduced later if we add
//    many preference fields.
//
// 2. GitHub ID as the unique external identity
//    `githubId` is the stable external identifier. The `id` field is an
//    internal cuid (not exposed to clients) so we can change identity
//    providers later without migrating foreign keys.
//
// 3. No access token stored in the database
//    The GitHub OAuth token is stored in the JWT session, not the DB.
//    This keeps the token lifecycle tied to the session (7-day max).
//    If we need long-lived token storage (background jobs, etc.), add
//    an `accessToken` field here.
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core user record, created/updated on every GitHub OAuth login.
model User {
  id        String   @id @default(cuid())
  githubId  Int      @unique
  login     String
  name      String?
  avatarUrl String?
  email     String?

  /// Preferred CV locale. Must be one of: en, tr, de, fr, es, pt, ja, ko, zh, ru, ar
  locale   String @default("en")
  /// Preferred CV template ID. Must be one of: classic_professional, developer_card, minimal
  template String @default("classic_professional")

  /// ── Billing / entitlements ─────────────────────────────────────
  /// Entitlement plan: free | pro | premium (see src/lib/billing/plans.ts)
  plan String @default("free")
  /// Subscription lifecycle: none | active | trialing | past_due | canceled
  planStatus String @default("none")
  /// When the current paid plan period ends (null for free / lifetime)
  planExpiresAt DateTime?
  /// Which payment provider holds the subscription ("stripe", "lemon_squeezy", ...).
  /// NULL until a provider is configured — the app never hardcodes a provider.
  billingProvider String?
  /// Customer id at the payment provider
  billingCustomerId String?
  /// Subscription id at the payment provider
  billingSubscriptionId String?
  /// Internal role: user | admin (role-based access control)
  role String @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// All CV profiles owned by this user
  profiles CvProfile[]
  /// Jobs the user is tracking (job application pipeline)
  jobs Job[]
  /// Analytics events recorded for this user
  analyticsEvents AnalyticsEvent[]
  /// Daily GitHub stat snapshots (growth tracking)
  githubSnapshots GithubSnapshot[]
  /// Cached AI tool results (24h TTL) — see AiResultCache
  aiResultCaches AiResultCache[]
}

/// A named CV configuration owned by a user.
/// Each profile stores a locale, template, and custom title so users
/// can maintain multiple CV variants (e.g. "Software Engineer", "Backend Developer").
model CvProfile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// User-given name for this profile (e.g. "Software Engineer", "Backend Developer")
  title    String @default("My CV")
  /// CV locale code. Must be one of: en, tr, de, fr, es, pt, ja, ko, zh, ru, ar
  locale   String @default("en")
  /// CV template ID. Must be one of: classic_professional, developer_card, minimal
  template String @default("classic_professional")

  /// Snapshot of the CvModel JSON shown on the public share page.
  /// Set when sharing is enabled; null when not shared.
  shareModel   Json?
  /// Random unguessable token for the public resume URL (/r/:token).
  shareToken   String?  @unique
  /// Whether the public share page is currently enabled.
  shareEnabled Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions CvVersion[]
  /// Analytics events that reference this profile
  analyticsEvents AnalyticsEvent[]

  @@unique([userId, title])
  @@index([userId])
}

/// A job the user is tracking (job search / application pipeline).
/// Stores the posting details plus the last computed match snapshot so
/// the list view can show scores without recomputing them.
model Job {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Company name (required)
  company String
  /// Job title (required)
  title String
  /// Posting URL
  url String?
  /// Full job description text — used for keyword extraction + matching
  description String?
  /// Application stage: saved | applied | interviewing | offer | rejected | archived
  status String @default("saved")
  /// User priority: low | medium | high
  priority String @default("medium")
  /// Free-form notes
  notes String?

  /// When the user applied
  appliedAt DateTime?
  /// Posting deadline (optional)
  deadline DateTime?

  /// Last computed match score (0-100), cached on the row
  matchScore Int?
  /// Last computed match analysis snapshot (JobMatchResult JSON)
  matchJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// An immutable snapshot of a CV configuration at a point in time.
/// Enables resume history, versioning, and side-by-side comparison.
model CvVersion {
  id        String   @id @default(cuid())
  profileId String
  profile   CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Optional human label, e.g. "Before refactor" or "v2"
  label    String?
  /// CvModel JSON snapshot (locale/template-agnostic, same shape as /api/cv-model)
  model    Json
  /// CV locale code at save time
  locale   String @default("en")
  /// CV template ID at save time
  template String @default("classic_professional")

  createdAt DateTime @default(now())

  @@index([profileId, createdAt])
}

/// A single tracked usage event (download, public view, export, share).
/// `userId` is null for public/anonymous events (e.g. a visitor viewing a
/// shared resume), so public activity can be counted without exposing who
/// the visitor is. `visitorHash` is a salted hash of the visitor's IP —
/// never the raw IP — used only to estimate unique visitors.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  /// Owning user; null for public/anonymous events
  userId    String?
  /// Target CV profile (when the event relates to one)
  profileId String?
  /// Event type: resume_view | cv_download | portfolio_export | portfolio_website | profile_share
  type      String
  /// Extra structured data (locale, template, format, theme, referrer...)
  metadata  Json?
  /// Salted hash of the visitor IP (unique-visitor estimation, privacy-safe)
  visitorHash String?

  createdAt DateTime @default(now())

  user    User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CvProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([profileId, type, createdAt])
  @@index([type, createdAt])
  @@index([visitorHash])
}

/// Daily snapshot of a user's public GitHub stats, used for growth charts.
/// One row per user per UTC day (upserted), so trends are cheap to query.
model GithubSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// UTC date (midnight) of the snapshot
  date      DateTime
  stars     Int
  repos     Int
  forks     Int
  followers Int

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

/// Cached AI tool results with a 24-hour TTL.
///
/// The dashboard fires up to 3 AI tools in parallel on every page load;
/// on Gemini's free tier (~10-15 RPM) a few refreshes exhaust the quota.
/// Caching per (user, tool, input-hash) means repeat page loads within
/// 24h are served from the database with ZERO LLM calls. A `regenerate`
/// request bypasses the read (but still refreshes the stored copy).
///
/// Best-effort by design: cache read/write failures are logged and the
/// AI call proceeds normally — the cache never blocks a feature.
model AiResultCache {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// AI tool name (aiTools registry key), e.g. "resume-review"
  tool      String
  /// SHA-256 of the tool + serialized request body (excludes `regenerate`)
  inputHash String
  /// Parsed tool result (tool-specific JSON shape)
  result    Json

  createdAt DateTime @default(now())
  /// created + 24h — rows past this point are treated as a miss and deleted lazily
  expiresAt DateTime

  @@unique([userId, tool, inputHash])
  @@index([userId, tool])
}

/// A company-side (recruiter) account. Fully independent of the GitHub
/// OAuth `User` flow — email + password auth via src/lib/recruiter-auth.ts.
///
/// ── Isolation ────────────────────────────────────────────────────
/// Deliberately NO relations to User or any other model: recruiters never
/// own CVs, jobs, or analytics rows. Sessions are separate too (cookie
/// `lillie_recruiter_session` with a `type: "recruiter"` JWT claim), so a
/// recruiter token can never be accepted by User routes and vice versa.
/// If recruiters later need to own data (candidate pools, postings), add
/// dedicated models then — don't retrofit relations onto this table.
///
/// ── Passwords ───────────────────────────────────────────────────
/// `passwordHash` stores a Node `crypto.scrypt` digest as "salt:hash"
/// (hex). Never store the plaintext password.
model Recruiter {
  id           String   @id @default(cuid())
  /// Login email — must be a company mailbox (consumer domains blocked at signup)
  email        String   @unique
  /// scrypt digest, stored as "salt:hash" — see src/lib/recruiter-auth.ts
  passwordHash String
  companyName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
