# ── LILLIE environment variables ────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit real secrets.

# ── Required: GitHub OAuth ─────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the callback URL configured on the GitHub OAuth App.
# Local:   http://localhost:3000/api/auth/callback
# Prod:    https://your-domain.com/api/auth/callback
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ── Required in production: session signing secret ─────────────────
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# ── Optional: canonical app URL (redirects, share links, sitemap) ──
# Local:   http://localhost:3000
# Prod:    https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Prisma) ──────────────────────────────────────────────
# The schema uses provider "postgresql" (Neon in production). For local
# development use any local PostgreSQL (or a Neon branch) connection string.
#   Local:   postgresql://postgres:postgres@localhost:5432/lillie?schema=public
#   Prod:    postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lillie?schema=public

# ── Optional: AI services (routes return 503 when unset) ───────────
AI_API_KEY=
AI_PROVIDER=openai        # openai | gemini
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ── Optional: analytics visitor-hash salt (set a strong random value) ──
ANALYTICS_SALT=

# ── Optional: billing provider (checkout/portal return 503 until set) ──
BILLING_PROVIDER=
