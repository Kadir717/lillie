# GitHub OAuth App credentials (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Random 32+ char string used to sign session cookies. Generate with:
# openssl rand -hex 32
SESSION_SECRET=replace_me_with_a_long_random_string

# Your deployed app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
